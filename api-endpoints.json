      "queryParams": [],
      "pathParams": [],
      "responses": {
        "200": {
          "raw": true,
          "example": {
            "status": "ok",
            "uptime": 25.629901,
            "timestamp": "2026-09-29T02:16:42.761Z"
          }
        }
      }
    },
