# Copy to `.env` (or `.env.local`) and adjust. Only JWT_SECRET is required.

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=*
SWAGGER_ENABLED=true

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=lessone7day
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10

# --- Auth ---
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-character-secret
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# --- Jobs ---
TASK_RETENTION_DAYS=30
TASK_CLEANUP_CRON=0 3 * * *