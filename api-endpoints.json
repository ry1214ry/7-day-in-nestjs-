{
  "name": "lessone-7day API",
  "version": "1.0.0",
  "baseUrl": "http://localhost:3000",
  "globalPrefix": "/api/v1",
  "documentation": {
    "swaggerUI": "http://localhost:3000/docs",
    "openApiJson": "http://localhost:3000/docs-json",
    "note": "The machine-readable OpenAPI 3 spec is also saved at ./api-spec.json and is generated live by the running server."
  },
  "conventions": {
    "authScheme": "Bearer JWT in the `Authorization` header, except for /health, /api/v1/health/info, /api/v1/auth/register and /api/v1/auth/login.",
    "responseEnvelope": "Every successful response except GET /health is wrapped by TransformInterceptor as { success, data, meta?, timestamp, path }. GET /health is raw.",
    "validation": "ValidationPipe runs with whitelist + forbidNonWhitelisted, so any unknown property in a JSON body is rejected with 400.",
    "idFormat": "All :id path params are UUID v4 and are enforced by ParseUUIDPipe.",
    "errorFormat": "HttpExceptionFilter maps thrown errors to { success: false, statusCode, message, error, path, timestamp }.",
    "softDelete": "Tasks use a DeleteDateColumn: DELETE sets deletedAt and the row is hidden from queries but retained.",
    "envFile": "JWT_SECRET and DB_* come from .env; the app refuses to boot without them."
  },
  "enums": {
    "TaskStatus": ["TODO", "IN_PROGRESS", "DONE", "ARCHIVED"],
    "TaskPriority": ["LOW", "MEDIUM", "HIGH", "URGENT"],
    "Role": ["ADMIN", "USER"]
  },
